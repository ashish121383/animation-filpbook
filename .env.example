# Application
APP_NAME=Premium OCR PDF Flipbook
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Premium OCR PDF Flipbook
VITE_APP_VERSION=1.0.0

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=flipbook
POSTGRES_PASSWORD=flipbook_secret
POSTGRES_DB=flipbook_db
DATABASE_URL=postgresql+asyncpg://flipbook:flipbook_secret@postgres:5432/flipbook_db
DATABASE_URL_SYNC=postgresql://flipbook:flipbook_secret@postgres:5432/flipbook_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=pdf
STORAGE_BACKEND=local

# S3 Storage (optional, set STORAGE_BACKEND=s3 to enable)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# OCR
OCR_DEFAULT_ENGINE=paddleocr
OCR_LANGUAGES=en
OCR_CONFIDENCE_THRESHOLD=0.6

# Nginx
NGINX_PORT=80
